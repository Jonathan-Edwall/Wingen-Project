# First-gene warm-up. Every report reads and fills the same on-disk caches (environmental layers, Natural Earth maps). Reports that start together on a cold cache all build them at once. With the switch on (the default), the first retained gene is prepared and reported ALONE, with the allocation's threads and memory; the other genes are planned (checkpoint first_gene_warmup_done) only once its report is done. What is awaited is a finished report, not a particular download, so it holds for any domain_type that caches under results_dir/temp (marine now, land later) without touching the Rmd. It only orders the work.
FIRST_GENE_WARMUP = config.get("first_gene_warmup", True)
if not isinstance(FIRST_GENE_WARMUP, bool):
    raise ValueError("first_gene_warmup must be a YAML boolean (true/false); "
                     "on the command line Snakemake only reads True/False, e.g. --config first_gene_warmup=False")
FIRST_GENE_THREADS = config.get("first_gene_threads", "auto")
# auto follows Snakemake's --cores budget via workflow.cores, like neutral_preparation_threads.
FIRST_GENE_THREADS = (workflow.cores if FIRST_GENE_THREADS == "auto" else
                      positive_integer_setting("first_gene_threads", 8))
FIRST_GENE_MEM_MB = config.get("first_gene_mem_mb", "auto")
if FIRST_GENE_MEM_MB != "auto":
    FIRST_GENE_MEM_MB = positive_integer_setting("first_gene_mem_mb", 40000)
FIRST_GENE_HEADROOM_MB = positive_integer_setting("first_gene_headroom_mb", 4096)
FIRST_GENE_RUNTIME = positive_integer_setting("first_gene_runtime_minutes", 240)
ORDINARY_REPORTS_COMPLETE = f"{RESULTS_DIR}/temp/ordinary_reports.complete"
FIRST_GENE_WARMUP_MARKER = f"{RESULTS_DIR}/temp/first_gene_warmup.json"


def allocation_memory_mb(headroom_mb):
    """Available declared budget, leaving headroom for the local scheduler."""
    limits = []
    configured = getattr(globals().get("workflow"), "global_resources", {}).get("mem_mb")
    configured = getattr(configured, "value", configured)
    if type(configured) is int and configured > 0:
        limits.append(configured)
    allocated = os.environ.get("SLURM_MEM_PER_NODE", "")
    if allocated.isdigit() and int(allocated) > 0:
        limits.append(int(allocated))
    if not limits:
        return None
    available = min(limits) - headroom_mb
    if available < 1:
        raise WorkflowError("Neutral memory headroom must be smaller than the allocation budget")
    return available


def neutral_reference_memory_mb():
    available = allocation_memory_mb(NEUTRAL_REFERENCE_HEADROOM_MB)
    requested = (available or 40000) if NEUTRAL_REFERENCE_MEM_MB == "auto" else NEUTRAL_REFERENCE_MEM_MB
    return min(requested, available) if available else requested


def neutral_preparation_memory_mb():
    available = allocation_memory_mb(NEUTRAL_PREPARATION_HEADROOM_MB)
    requested = (available or 8000) if NEUTRAL_PREPARATION_MEM_MB == "auto" else NEUTRAL_PREPARATION_MEM_MB
    return min(requested, available) if available else requested


def first_gene_memory_mb():
    # Same arithmetic as the neutral reference: the declared budget minus headroom ("auto"),
    # or the configured number limited to that budget. Without any budget it asks for what an
    # ordinary report asks for, since "everything" is then unknown.
    try:
        available = allocation_memory_mb(FIRST_GENE_HEADROOM_MB)
    except WorkflowError:
        raise WorkflowError("first_gene_headroom_mb must be smaller than the allocation budget") from None
    requested = (available or 40000) if FIRST_GENE_MEM_MB == "auto" else FIRST_GENE_MEM_MB
    return min(requested, available) if available else requested



def is_neutral_reference(wildcards):
    return (RUN_NEUTRAL_REFERENCE
            and (wildcards.chrom, wildcards.gene) == NEUTRAL_REFERENCE_LOCUS)


def run_neutral_for_locus(wildcards):
    # The full pool gets one report, not matched-size simulations of itself.
    return RUN_NEUTRAL_SIM and not is_neutral_reference(wildcards)


