rule run_wingen_report:
    """
    create_gene_catalog()'s Rscript call: render the Wingen Rmd against
    one gene's filtered VCF.

    Output is a per-gene `.done` marker. The uniquely named summary JSON
    and PNGs remain side effects in the shared chromosome folder (or the
    reserved neutral_pool output category). The availability manifest
    lists the active summaries explicitly for aggregation.

    intermediates_dir is gene-specific (.render_{gene}, not a shared
    .render) for the same reason: multiple genes now render into the SAME
    chromosome folder, possibly concurrently, so anything that isn't
    already gene-specific by name is a collision waiting to happen -
    this was true before too (per-run rather than per-chromosome), just
    more exposed now that the folder itself is shared.
    """
    wildcard_constraints:
        chrom=r"chr[^/]+",
    input:
        vcf=wingen_vcf_input,
        pool_metadata=lambda wc: [NEUTRAL_POOL_MANIFEST] if NEUTRAL_POOL_MAX_MARKERS is not None and (is_neutral_reference(wc) or run_neutral_for_locus(wc)) else [],
        coords=config["sample_coordinates_file"],
        rmd="code/2_Herring_Wingen.Rmd",
        wingen_helpers=report_wingen_helper_inputs,
        model_agreement_sources=report_location_screening_inputs,
        # One stable order-only dependency preserves reference reuse when the
        # ordinary gene limit/input list expands. Pool preparation stays earlier.
        ordinary_reports=lambda wc: [ancient(ORDINARY_REPORTS_COMPLETE)] if is_neutral_reference(wc) else [],
        neutral_pool=lambda wc: [NEUTRAL_POOL] if run_neutral_for_locus(wc) else [],
        neutral_pool_index=lambda wc: ([NEUTRAL_REFERENCE_INDEX] if is_neutral_reference(wc) else
                                        [NEUTRAL_POOL_INDEX] if run_neutral_for_locus(wc) else []),
        reference_metadata=lambda wc: [NEUTRAL_REFERENCE_MANIFEST] if is_neutral_reference(wc) and NEUTRAL_REFERENCE_MAX_MARKERS is not None else [],
        neutral_plan=lambda wc: [f"{NEUTRAL_DIR}/{wc.chrom}/{wc.gene}/subsets.tsv"] if run_neutral_for_locus(wc) else [],
        neutral_metadata=lambda wc: [f"{NEUTRAL_DIR}/{wc.chrom}/{wc.gene}/plan_metadata.json"] if run_neutral_for_locus(wc) else [],
        neutral_prepared=lambda wc: [f"{NEUTRAL_DIR}/{wc.chrom}/{wc.gene}/prepared_vcfs"] if run_neutral_for_locus(wc) else [],
        # Not read by the shell command - listed so that editing the environmental-dataset presets (ENV_PRESET in
        # config.yaml picks one) re-runs the genes, like editing the Rmd does. Remove if you do not use presets.
        presets="config/env_presets.yaml",
    output:
        # outdir=directory("results/gene_catalog/{chrom}/{gene}"),
        # outdir=directory(f"results/gene_catalog/{chrom}"), # Placeholder until i fix chr/gene* structure.
        done=f"{RESULTS_DIR}/.snakemake_gene_catalog/{{chrom}}/{{gene}}.done",
    benchmark:
        #     # native equivalent of the /usr/bin/time -v wrapping just added to
        #     # create_gene_catalog() - wall time, max RSS, CPU time, per gene,
        #     # written automatically every run instead of needing manual
        #     # wrapping. Also where the exact per-gene "Elapsed" number missing
        #     # from the resources: comment below would come from.
        # "results/gene_catalog/{chrom}/{gene}/benchmark.tsv"
        # "results/gene_catalog/{chrom}/{gene}_benchmark.tsv" # Placeholder until i fix chr/gene* structure.
        f"{RESULTS_DIR}/benchmarks/{{chrom}}/{{gene}}.tsv" # GPT test for chr/gene* structure.
    container:
        CONTAINER
    # conda:
    #     "wingen_env"
    # container:
    #     "docker://ghcr.io/OWNER/wingen-report:latest"  # built from Dockerfile below
    # params:
    #     filter_mode=filter_mode,
    #     study_species=config["study_species"],
    #     calc_gen_diversity_stats=config["calc_gen_diversity_stats"],
    #     lat_min=config["lat_min"],
    #     lat_max=config["lat_max"],
    #     lon_min=config["lon_min"],
    #     lon_max=config["lon_max"],
    #     wingen_env=wingen_env_prefix,
    #     # rmarkdown::render() setwd()s into the .Rmd's own directory (code/)
    #     # unless knit_root_dir is given, so any repo-root-relative path handed
    #     # to the Rmd gets resolved against code/ instead. The bash track never
    #     # hit this because everything it exported was already absolute.
    #     vcf_abs=lambda wc, input: os.path.abspath(input.vcf),
    #     rmd_abs=lambda wc, input: os.path.abspath(input.rmd),
    #     outdir_abs=lambda wc, output: os.path.abspath(output.outdir),

    # GPT test for chr/gene* structure.
    params:
        filter_mode=filter_mode,
        study_species=config["study_species"],
        domain_type=config["domain_type"],
        calc_gen_diversity_stats=config["calc_gen_diversity_stats"],
        use_copernicus_marine=config["use_copernicus_marine"],
        gd_stat=GD_STAT,
        gd_dosage_missing_policy=GD_DOSAGE_MISSING_POLICY,
        gd_label=config.get("gd_label", ""),
        gd_label_short=config.get("gd_label_short", ""),
        lat_min=config.get("lat_min", ""),
        lat_max=config.get("lat_max", ""),
        lon_min=config.get("lon_min", ""),
        lon_max=config.get("lon_max", ""),
        # lat_min=config["lat_min"],
        # lat_max=config["lat_max"],
        # lon_min=config["lon_min"],
        # lon_max=config["lon_max"],
        wingen_env=wingen_env_prefix,

        # outdir_abs=lambda wc: os.path.abspath(
        #     f"results/gene_catalog/{wc.chrom}"
        # ),
        # vcf_abs=lambda wc, input: os.path.abspath(input.vcf),
        # rmd_abs=lambda wc, input: os.path.abspath(input.rmd),

        outdir_abs=lambda wc: abspath_pwd(f"{RESULTS_DIR}/results/{wc.chrom}"),
        root_abs=abspath_pwd("."),
        vcf_abs=lambda wc, input: abspath_pwd(input.vcf),
        rmd_abs=lambda wc, input: abspath_pwd(input.rmd),
        env_cache_dir_abs=ENV_CACHE_DIR_ABS,
        ne_cache_dir_abs=NE_CACHE_DIR_ABS,
        run_neutral_sim=run_neutral_for_locus,
        neutral_reference=is_neutral_reference,
        pool_metadata_abs=lambda wc: abspath_pwd(NEUTRAL_POOL_MANIFEST) if NEUTRAL_POOL_MAX_MARKERS is not None and (is_neutral_reference(wc) or run_neutral_for_locus(wc)) else "",
        reference_metadata_abs=lambda wc: abspath_pwd(NEUTRAL_REFERENCE_MANIFEST) if is_neutral_reference(wc) and NEUTRAL_REFERENCE_MAX_MARKERS is not None else "",
        future_options=lambda wc: "options(future.globals.maxSize = Inf)" if is_neutral_reference(wc) else "",
        neutral_plan_abs=lambda wc: abspath_pwd(f"{NEUTRAL_DIR}/{wc.chrom}/{wc.gene}/subsets.tsv") if run_neutral_for_locus(wc) else "",
        # Absolute paths keep these per-gene files readable from R's render directory.
        neutral_metadata_abs=lambda wc: abspath_pwd(f"{NEUTRAL_DIR}/{wc.chrom}/{wc.gene}/plan_metadata.json") if run_neutral_for_locus(wc) else "",
        neutral_min_valid_fraction=lambda wc: config.get("min_valid_fraction", 0.9) if run_neutral_for_locus(wc) else 0.9,
        neutral_prepared_manifest_abs=lambda wc: abspath_pwd(f"{NEUTRAL_DIR}/{wc.chrom}/{wc.gene}/prepared_vcfs/manifest.json") if run_neutral_for_locus(wc) else "",
        neutral_extreme_value_percentiles=lambda wc: NEUTRAL_EXTREME_VALUE_PERCENTILES if run_neutral_for_locus(wc) else "",
    threads: lambda wc: NEUTRAL_REFERENCE_THREADS if is_neutral_reference(wc) else FIRST_GENE_THREADS if is_first_gene(wc) else 2
    resources:
        # from real sacct data (job 6675358, batch_job_gene_catalog.sh):
        # TotalCPU/Elapsed ~= 0.96 -> effectively single-threaded, hence
        # threads=2 (1 needed + 1 margin, matching that script's own -c 2);
        # MaxRSS ~= 28.3GB peak -> mem_mb below matches the 40G that
        # script now requests. That job ran two genes sequentially in one
        # allocation though, and each gets a fresh Rscript process (no
        # memory carries over between them), so 28.3GB is a reasonable
        # per-gene peak, not a two-gene sum. runtime is the one number
        # here I don't have a clean per-gene split for - the sacct data
        # shared didn't include absolute Elapsed, only the CPU ratio - so
        # this is still more of a guess than the other two; the "Elapsed"
        # field from that same sacct command would settle it directly.
        # mem_mb=40000,
        # runtime=45,
        # The first gene (first_gene_warmup) asks for everything the allocation has, with no
        # attempt multiplier - like the reference. It is the only report running, so the cold
        # download/build gets the whole machine, and a retry starts from the same request.
        mem_mb=lambda wildcards, attempt: neutral_reference_memory_mb() if is_neutral_reference(wildcards) else first_gene_memory_mb() if is_first_gene(wildcards) else 40000 * attempt,
        runtime=lambda wildcards, attempt: NEUTRAL_REFERENCE_RUNTIME if is_neutral_reference(wildcards) else FIRST_GENE_RUNTIME if is_first_gene(wildcards) else 45 * attempt,
    retries: 2
    # shell:
    #     """
    #     mkdir -p {params.outdir_abs}/.render
    #     filtered_vcf_file={params.vcf_abs} \
    #     sample_coordinates_file={input.coords} \
    #     vcf_filter_mode={params.filter_mode} \
    #     vcf_filter_value={wildcards.gene} \
    #     study_species={params.study_species} \
    #     calc_gen_diversity_stats={params.calc_gen_diversity_stats} \
    #     LAT_MIN={params.lat_min} LAT_MAX={params.lat_max} \
    #     LON_MIN={params.lon_min} LON_MAX={params.lon_max} \
    #     wingen_output_dir={params.outdir_abs} \
    #     {params.wingen_env} \
    #     Rscript -e "rmarkdown::render('{params.rmd_abs}', run_pandoc=FALSE, intermediates_dir='{params.outdir_abs}/.render')"
    #     rm -rf {params.outdir_abs}/.render
    #     """

    # GPT test for chr/gene* structure.
    shell:
        """
        mkdir -p {params.outdir_abs}/.render_{wildcards.gene}
        filtered_vcf_file={params.vcf_abs} \
        sample_coordinates_file={input.coords} \
        vcf_filter_mode={params.filter_mode} \
        vcf_filter_value={wildcards.gene} \
        study_species={params.study_species:q} \
        DOMAIN_TYPE={params.domain_type} \
        calc_gen_diversity_stats={params.calc_gen_diversity_stats} \
        USE_COPERNICUS_MARINE={params.use_copernicus_marine} \
        GENE_CATALOG_RUN=TRUE \
        GD_STAT={params.gd_stat:q} \
        GD_DOSAGE_MISSING_POLICY={params.gd_dosage_missing_policy:q} \
        GD_LABEL={params.gd_label:q} \
        GD_LABEL_SHORT={params.gd_label_short:q} \
        LAT_MIN={params.lat_min} \
        LAT_MAX={params.lat_max} \
        LON_MIN={params.lon_min} \
        LON_MAX={params.lon_max} \
        wingen_output_dir={params.outdir_abs} \
        ENV_CACHE_DIR={params.env_cache_dir_abs} \
        NE_CACHE_DIR={params.ne_cache_dir_abs} \
        NEUTRAL_PLAN={params.neutral_plan_abs:q} \
        NEUTRAL_PLAN_METADATA={params.neutral_metadata_abs:q} \
        NEUTRAL_MIN_VALID_FRACTION={params.neutral_min_valid_fraction} \
        NEUTRAL_PREPARED_MANIFEST={params.neutral_prepared_manifest_abs:q} \
        NEUTRAL_EXTREME_VALUE_PERCENTILES={params.neutral_extreme_value_percentiles:q} \
        {params.wingen_env} \
        ROOT={params.root_abs:q} \
        RUN_NEUTRAL_SIM={params.run_neutral_sim} \
        NEUTRAL_REFERENCE={params.neutral_reference} \
        NEUTRAL_REFERENCE_MANIFEST={params.reference_metadata_abs:q} \
        NEUTRAL_POOL_MANIFEST={params.pool_metadata_abs:q} \
        Rscript -e "
        {params.future_options}
        future::plan(future::multisession, workers = {threads})
        message('[wingen] future workers: ', future::nbrOfWorkers())
        rmarkdown::render('{params.rmd_abs}', run_pandoc=FALSE, intermediates_dir='{params.outdir_abs}/.render_{wildcards.gene}')
        future::plan(future::sequential)
        " 2>&1 | gawk 'BEGIN {{ RS="\\r|\\n" }} {{ sub(/^ *Progress: [ ─-]*100%/, ""); if (length($0)) {{ print; fflush() }} }}'
        rm -rf {params.outdir_abs}/.render_{wildcards.gene}

        mkdir -p "$(dirname {output.done})"
        touch {output.done}
        """

if RUN_NEUTRAL_REFERENCE:
    # Inherit the identical Rmd/render command; only target category and retries
    # differ. A failed reference report never silently reduces the configured markers.
    use rule run_wingen_report as run_neutral_reference_report with:
        wildcard_constraints:
            chrom="neutral_pool",
            gene=re.escape(NEUTRAL_REFERENCE_ID),
        retries: 0


# rule aggregate_gene_summaries:
#     """
#     Waits on every gene's .done marker (done_marker_paths(), built from
#     GENE_CHROM above - see that function's own comment for why a marker
#     file rather than {gene}_gene_summary.json directly), then loads every
#     gene's *_gene_summary.json into one DuckDB table with a single glob
#     read - see the script for why this is safe to do as a single pass
#     with no concurrency concerns of its own: by the time this rule can
#     even start, every gene's marker (and therefore its summary file)
#     already exists and nothing else is writing to any of them.
#     """
#     input:
#         markers=done_marker_paths(),
#     output:
#         duckdb="results/gene_catalog/gene_catalog.duckdb",
#         tsv="results/gene_catalog/gene_catalog_summary.tsv",
#     conda:
#         "wingen_env"
#     # container:
#     #     CONTAINER
#     script:
#         "../code/aggregate_gene_summaries.py"

rule aggregate_gene_summaries:
    input:
        markers=done_marker_paths,
        availability=availability_manifest,
        # Empty without first_gene_warmup: the time the first gene's report finished (see the function).
        first_report_time=first_gene_warmup_stamp,
        script="code/aggregate_gene_summaries.py",
        # The gene-list BED, read here for its optional gene name (column 5) and description
        # (column 6). Names are joined in at this last step and never passed into a gene's analysis,
        # so editing a name re-runs this step, the catalog page and the cheap gene-selection step
        # that also reads the BED - never a gene's analysis. (Snakemake compares file CONTENT, not
        # just timestamps: rewriting the BED with identical bytes re-runs nothing.)
        gene_list=[GENE_LIST_FILE] if gene_list_source == "bed" and os.path.isfile(GENE_LIST_FILE) else [],

    output:
        duckdb=f"{RESULTS_DIR}/results/gene_catalog.duckdb",
        tsv=f"{RESULTS_DIR}/results/gene_catalog_summary.tsv",
    params:
        gene_list_arg=lambda wildcards, input: (
            f"--gene-list {shlex.quote(input.gene_list[0])}" if len(input.gene_list) else ""
        ),
    container:
        CONTAINER
    # conda:
    #     "wingen_env"
    shell:
        """
        python {input.script:q} \
            --availability-manifest {input.availability:q} \
            --duckdb {output.duckdb:q} \
            --tsv {output.tsv:q} \
            {params.gene_list_arg}
        """


