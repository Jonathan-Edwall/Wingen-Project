        # Prepare every replicate for this chromosome/gene only. Its R report
        # waits here; other genes can prepare or analyse their own VCFs in parallel.
        input:
            pool=NEUTRAL_POOL,
            index=NEUTRAL_POOL_INDEX,
            plan=rules.plan_neutral_subsets.output.plan,
            metadata=rules.plan_neutral_subsets.output.metadata,
