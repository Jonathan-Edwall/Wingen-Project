def wingen_env_prefix(wildcards):
    """Turn config['wingen_params'] into 'KEY1="val1" KEY2="val2" ...' for
    the shell command below. Anything not set in config.yaml is simply
    omitted, so the Rmd's own Sys.getenv(..., unset = default) fallback
    applies - exactly like leaving the matching export commented out in
    2_wingen_create_gene_catalog.sh does today."""
    params = config.get("wingen_params", {}) or {}
    return " ".join(f'{k}="{v}"' for k, v in params.items() if v is not None)


rule filter_vcf_for_gene:
    """create_gene_vcf_file(): subset the cohort VCF to one gene's variants."""
    input:
        vcf=config["input_vcf"],
    output:
        vcf=f"{RESULTS_DIR}/temp/filtered_vcf/{{chrom}}/{{gene}}_filtered.vcf.gz",
    params:
        mode=filter_mode,
        value=filter_value,
        chrom=filter_chrom,
    container:
        CONTAINER
    # conda:
    #     "wingen_env"
    # container:
    #     # confirmed to exist on quay.io as of this writing - still worth
    #     # picking the exact bcftools version you actually want rather
    #     # than trusting this pin blindly
    #     "docker://quay.io/biocontainers/bcftools:1.21--h3a4d415_1"
    threads: 2
    resources:
        # not measured separately from run_wingen_report below - filtering
        # a single small gene region is a much lighter operation than the
        # R rendering step, these are a deliberately small guess rather
        # than an attempt at a real number
        # mem_mb=2000,
        # runtime=10,
        mem_mb=lambda wildcards, attempt: 2000 * attempt,
        runtime=lambda wildcards, attempt: 10 * attempt,
    retries: 2
    shell:
        """
        export FILTER_GENE_CHROM={params.chrom:q}
        bash code/filter_vcf_by_chr_or_gene.sh \
            {input.vcf:q} {params.mode:q} {params.value:q} {output.vcf:q} true
        """


rule narrow_vcf_by_scope:
    """
    filter_vcf_by_scope.sh: narrow an already gene-filtered VCF down to a
    specific annotation scope (body/exonic/cds), reading each variant's
    own ANN block for this gene. Only ever appears in the DAG when
    config['gene_scope'] != "all" - see wingen_vcf_input() below, which
    decides whether run_wingen_report depends on this rule's output or
    skips straight to filter_vcf_for_gene's.
    """
    input:
        vcf=rules.filter_vcf_for_gene.output.vcf,
    output:
        vcf=f"{RESULTS_DIR}/temp/filtered_vcf/{{chrom}}/{{gene}}_{GENE_SCOPE}.vcf.gz",
    params:
        gene=lambda wc: wc.gene,
        scope=GENE_SCOPE,
    container:
        CONTAINER
    # conda:
    #     "wingen_env"
    # container:
    #     "docker://quay.io/biocontainers/bcftools:1.21--h3a4d415_1"
    threads: 2
    resources:
        # mem_mb=2000,
        # runtime=10,
        mem_mb=lambda wildcards, attempt: 2000 * attempt,
        runtime=lambda wildcards, attempt: 10 * attempt,
    retries: 2
    shell:
        """
        bash code/filter_vcf_by_scope.sh \
            {input.vcf} {params.gene} {params.scope} {output.vcf} true
        """


def wingen_vcf_input(wildcards):
    """Feeds run_wingen_report the scope-narrowed VCF when gene_scope is
    set, otherwise the plain gene-filtered VCF - mirrors filtered_vcf_file
    only getting reassigned to scope_vcf_file in create_gene_catalog()
    when gene_scope != "all"."""
    if GENE_SCOPE != "all":
        return f"{RESULTS_DIR}/temp/filtered_vcf/{wildcards.chrom}/{wildcards.gene}_{GENE_SCOPE}.vcf.gz"
    return f"{RESULTS_DIR}/temp/filtered_vcf/{wildcards.chrom}/{wildcards.gene}_filtered.vcf.gz"


