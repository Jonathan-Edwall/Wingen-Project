def neutral_normalization_options():
    options = {
        "sheet": config.get("sheet", "Sheet1"),
        "header-row": config.get("header_row", "auto"),
        "input-format": NEUTRAL_INPUT_FORMAT,
        "chrom-column": config.get("chrom_column", 1),
        "pos-column": config.get("pos_column", 2),
        "marker-label-column": config.get("marker_label_column") or "TYPE",
        "neutral-marker-label": config.get("neutral_marker_label", "NEUTRAL"),
    }
    # Keep arguments separate; Snakemake's :q formatter quotes each list item.
    # Omit unset optional flags so argparse uses its empty-string defaults.
    arguments = [argument for key, value in options.items() if value is not None and value != ""
                 for argument in (f"--{key}", str(value))]
    if config.get("neutral_only", False):
        arguments.append("--neutral-only")
    return arguments

# ---- gene list, chromosomes and (BED mode) regions ----
#
# Two independent questions, answered by independent config keys:
#   1. WHICH genes run?                    gene_list_file, or the inline 'genes' list
#   2. HOW are a gene's variants found     vcf_annotation_format: snpeff | bed
#      in the VCF?
#
# The type of the gene list is not configured, it is read from the list itself:
#   gene_list_file ending in .bed  -> a BED: chrom, start, end, gene ID - one row per gene
#   any other gene_list_file       -> a txt: one gene ID per line
#   no gene_list_file              -> SnpEff: unique_genes.txt; BED: unique_genes.bed
#                                    only with an existing annotation table, otherwise inline genes
# A configured or automatically named gene file takes precedence over inline genes.
#
# The same BED row then does the rest of the work: its first column is the gene's chromosome
# (it names the gene's output folder), and with vcf_annotation_format: bed - locating genes by
# coordinate, for a VCF without ANN - its start/end are the region handed to bcftools. Only a
# txt list or 'genes' combined with vcf_annotation_format: snpeff has no BED to read the
# chromosome from, which is the one case that still needs gene_chrom_file.

def read_gene_bed(bed_file):
    """Parse a gene BED into {(normalized chrom, gene): (chrom, start, end)}.

    The one place this pipeline reads a gene BED - the gene list, each gene's
    chromosome and each gene's region all come out of it, so they can't
    disagree about what counts as a valid row.

    Columns: 1 chromosome, 2 start, 3 end, 4 gene ID; anything after that is
    ignored. chrom is exactly as written in the file; start/end are the BED's
    own coordinates (0-based start, end exclusive).

    Skipped: blank lines, '#' comments, UCSC 'track'/'browser' lines, and ONE
    header row at the very top (a first row whose start/end aren't integers).
    Anything else malformed raises, with file and line number, rather than
    leaving a gene silently missing from the catalog: fewer than 4 columns,
    non-integer coordinates after that first row, an empty gene ID, an empty
    interval (start >= end), or conflicting regions for a gene on one chromosome.
    """
    genes = {}
    line_of = {}
    skipped_header = False
    with open(bed_file) as f:
        for line_number, raw in enumerate(f, start=1):
            line = raw.strip()
            if not line or line.startswith("#") or line.split(None, 1)[0] in ("track", "browser"):
                continue

            # BED is tab-delimited; fall back to any whitespace for a space-delimited file
            fields = line.split("\t") if "\t" in line else line.split()
            if len(fields) < 4:
                raise ValueError(
                    f"{bed_file}, line {line_number}: expected at least 4 columns "
                    f"(chrom, start, end, gene ID), got {len(fields)}"
                )

            try:
                start, end = int(fields[1]), int(fields[2])
            except ValueError:
                if not genes and not skipped_header:
                    skipped_header = True  # a header row at the top of the file
                    continue
                raise ValueError(
                    f"{bed_file}, line {line_number}: start and end must be integers, "
                    f"got {fields[1]!r} and {fields[2]!r}"
                ) from None

            chrom, gene = fields[0], fields[3].strip()
            if not gene:
                raise ValueError(f"{bed_file}, line {line_number}: empty gene ID in column 4")
            if start < 0 or end <= start:
                raise ValueError(
                    f"{bed_file}, line {line_number}: expected 0 <= start < end, got "
                    f"start={start}, end={end} (gene {gene!r})"
                )
            locus = (normalize_chrom(chrom), gene)
            if locus in genes:
                if genes[locus][1:] != (start, end):
                    raise ValueError(
                        f"{bed_file}: different regions for gene {gene!r} on {locus[0]} "
                        f"at lines {line_of[locus]} and {line_number}"
                    )
                continue
            genes[locus] = (chrom, start, end)
            line_of[locus] = line_number

    if not genes:
        raise ValueError(f"{bed_file}: no gene rows found")
    return genes


def read_gene_txt(txt_file):
    """Read a plain gene list: one gene ID per line, in file order.

    Blank lines and '#' comments are skipped. A line with more than one column
    raises instead of being taken as a (nonsense) gene ID - the usual cause is
    a BED file whose name doesn't end in .bed, since the list type is read from
    the extension.
    """
    genes = []
    with open(txt_file) as f:
        for line_number, raw in enumerate(f, start=1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if len(line.split()) > 1:
                raise ValueError(
                    f"{txt_file}, line {line_number}: expected one gene ID per line, got "
                    f"{line!r}. If this is a BED file, rename it to end in .bed - the gene "
                    f"list type is read from the file extension."
                )
            genes.append(line)

    if not genes:
        raise ValueError(f"{txt_file}: no gene IDs found")
    return genes


VCF_ANNOTATION_FORMAT = config.get("vcf_annotation_format")
if VCF_ANNOTATION_FORMAT not in ("snpeff", "bed"):
    raise ValueError(
        f"vcf_annotation_format must be 'snpeff' or 'bed', got {VCF_ANNOTATION_FORMAT!r}"
    )

# 1. WHICH genes run, and what kind of list that is
GENE_LIST_FILE = config.get("gene_list_file") or None  # unset, null and "" all mean "no file"
if not GENE_LIST_FILE:
    if VCF_ANNOTATION_FORMAT == "snpeff":
        GENE_LIST_FILE = os.path.join(os.path.dirname(config["input_vcf"]) or ".", "unique_genes.txt")
    elif config.get("gene_annotation_file") and os.path.isfile(config["gene_annotation_file"]):
        GENE_LIST_FILE = os.path.join(os.path.dirname(config["input_vcf"]) or ".", "unique_genes.bed")
elif not os.path.dirname(GENE_LIST_FILE):
    GENE_LIST_FILE = os.path.join(os.path.dirname(config["input_vcf"]) or ".", GENE_LIST_FILE)
gene_list_source = (
    "array" if not GENE_LIST_FILE
    else "bed" if GENE_LIST_FILE.lower().endswith(".bed")
    else "txt"
)

# Retired keys. gene_list_source is no longer read, but a config that still sets it must not
# quietly start meaning something else: a leftover that agrees with what is now inferred is
# ignored, one that disagrees is refused.
_old_source = config.get("gene_list_source")
if _old_source and _old_source != gene_list_source:
    raise ValueError(
        f"config['gene_list_source'] is {_old_source!r}, but the gene list type is now read "
        f"from gene_list_file's extension (.bed = bed, anything else = txt; an omitted file "
        f"defaults to SnpEff TXT or annotation-derived BED when available, otherwise inline genes) "
        f"and that gives {gene_list_source!r} here. Delete the "
        f"gene_list_source line, and check that gene_list_file / genes are what you meant to run."
    )

# vcf_annotation_format: bed finds each gene by the coordinates in its BED row, so the gene
# list has to be that BED. (There is no separate gene_bed_file any more; a leftover one that
# points at the same file is ignored, one that points elsewhere is refused for the same
# reason as above - it would silently change which coordinates get used.)
if VCF_ANNOTATION_FORMAT == "bed":
    if gene_list_source != "bed":
        what = (
            f"gene_list_file ({GENE_LIST_FILE}) is a txt list"
            if gene_list_source == "txt"
            else "the genes are given as the inline 'genes' list"
        )
        raise ValueError(
            f"vcf_annotation_format: bed finds each gene by the coordinates in its BED row, so "
            f"the gene list must be a BED file (chrom, start, end, gene ID) ending in .bed - "
            f"but {what}. To run only some genes, filter the BED down to them, e.g. "
            f"awk 'NR==FNR{{a[$1]; next}} $4 in a' list.txt genes.bed > subset.bed"
        )
    _old_bed = config.get("gene_bed_file")
    if _old_bed and os.path.realpath(_old_bed) != os.path.realpath(GENE_LIST_FILE):
        raise ValueError(
            f"config['gene_bed_file'] ({_old_bed}) is no longer read: with vcf_annotation_format: "
            f"bed the regions come from gene_list_file ({GENE_LIST_FILE}). Delete the "
            f"gene_bed_file line, or point gene_list_file at the BED you want to use."
        )

# 2. Read the list and resolve each chromosome/gene pair.
LIST_BED = None
if gene_list_source == "array":
    GENES = list(config["genes"])
elif gene_list_source == "txt":
    GENES = read_gene_txt(GENE_LIST_FILE)
else:
    LIST_BED = read_gene_bed(GENE_LIST_FILE)
    GENES = [gene for _chrom, gene in LIST_BED]

if any(not isinstance(gene, str) or not re.fullmatch(r"[\w][\w.:-]*", gene) for gene in GENES):
    raise ValueError("Gene IDs must use letters, digits, underscores, dots, colons or hyphens, without spaces or path separators")
if RUN_NEUTRAL_REFERENCE and NEUTRAL_REFERENCE_ID in GENES:
    raise ValueError(f"neutral_reference_id {NEUTRAL_REFERENCE_ID!r} already occurs in the gene list")

# Chromosome folders use normalized names; filtering retains the original VCF name.
GENE_CHROM = {}  # gene_id -> normalized chromosomes
LOCUS_CHROM = {}  # (normalized chromosome, gene_id) -> original chromosome
if LIST_BED is not None:
    CHROM_SOURCE = GENE_LIST_FILE
    LOCI = list(LIST_BED)
    for locus, (chrom, _start, _end) in LIST_BED.items():
        GENE_CHROM.setdefault(locus[1], []).append(locus[0])
        LOCUS_CHROM[locus] = chrom
else:
    CHROM_SOURCE = config.get("gene_chrom_file")
    if not CHROM_SOURCE:
        # raise ValueError(
        #     "gene_chrom_file is required for a txt gene list (or the inline 'genes' list) "
        #     "together with vcf_annotation_format: snpeff - build it with "
        #     "code/build_gene_chrom_map.py. With a BED gene list the chromosomes are read from "
        #     "the BED instead, and it can be left out."
        # )
        CHROM_SOURCE = os.path.join(os.path.dirname(config["input_vcf"]) or ".", "gene_chrom.tsv")
    elif not os.path.dirname(CHROM_SOURCE) and not os.path.isfile(CHROM_SOURCE):
        CHROM_SOURCE = os.path.join(os.path.dirname(config["input_vcf"]) or ".", CHROM_SOURCE)
    with open(CHROM_SOURCE) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            chrom, gene = line.split("\t", 1)
            locus = (normalize_chrom(chrom), gene)
            if locus not in LOCUS_CHROM:
                GENE_CHROM.setdefault(gene, []).append(locus[0])
                LOCUS_CHROM[locus] = chrom
    GENES = list(dict.fromkeys(GENES))


# mirrors gene_list_limit in 2_wingen_create_gene_catalog.sh - caps the
# resolved gene list to its first N genes, for a quick test run without
# needing a separate small gene_list_file
gene_list_limit = config.get("gene_list_limit")
if gene_list_limit is not None:
    if LIST_BED is not None:
        LOCI = LOCI[:gene_list_limit]
        GENES = [gene for _chrom, gene in LOCI]
    else:
        GENES = GENES[:gene_list_limit]

if not GENES and not (RUN_NEUTRAL_REFERENCE and gene_list_limit == 0):
    raise ValueError("No genes to process - check config['genes'] or config['gene_list_file']")
missing_chrom = [g for g in GENES if g not in GENE_CHROM]
if missing_chrom:
    print(
        f"{len(missing_chrom)} requested gene(s) have no chromosome mapping in "
        f"{CHROM_SOURCE}; these will be recorded in {RESULTS_DIR}/skipped_genes.tsv. "
        f"Regenerate the mapping if it may be out of date."
    )
if LIST_BED is None:
    # A map built from the input VCF legitimately has no entry for an absent gene.
    # Keep such requests for the skip report, without scheduling a filter job.
    LOCI = [(chrom, gene) for gene in GENES
            for chrom in GENE_CHROM.get(gene, ["unmapped"])]
# mirrors the gene_scope checks in 2_wingen_create_gene_catalog.sh
GENE_SCOPE = config.get("gene_scope", "all")
if GENE_SCOPE not in ("all", "body", "exonic", "cds"):
    raise ValueError(f"gene_scope must be 'all', 'body', 'exonic', or 'cds', got {GENE_SCOPE!r}")
if GENE_SCOPE != "all" and VCF_ANNOTATION_FORMAT == "bed":
    raise ValueError(
        f"gene_scope={GENE_SCOPE!r} requires vcf_annotation_format='snpeff' - the "
        f"'bed' pathway has no ANN in the vcf to check scope against"
    )


# ---- Genetic diversity statistic ----
# The Rmd validates gd_stat again 
# Matched case-insensitively to the names from wingen; "ho" in config.yaml still reaches window_gd() as "Ho". The Rmd dispatches the dosage metrics to window_general().
GD_STATS = ("pi", "Ho", "biallelic_richness", "tajimas_d", "theta")
GD_STAT_NAMES = {s.lower(): s for s in GD_STATS}
GD_STAT_NAMES["watterson_theta"] = "theta"  # compatibility with earlier configurations
GD_STAT = GD_STAT_NAMES.get(str(config.get("gd_stat") or "pi").lower())
if GD_STAT is None:
    raise ValueError(f"gd_stat must be one of {', '.join(GD_STATS)}, got {config.get('gd_stat')!r}")

GD_DOSAGE_MISSING_POLICY = str(config.get("gd_dosage_missing_policy") or "hierfstat").lower()
if GD_DOSAGE_MISSING_POLICY not in ("complete_sites", "hierfstat"):
    raise ValueError("gd_dosage_missing_policy must be complete_sites or hierfstat, "
                     f"got {config.get('gd_dosage_missing_policy')!r}")

def gd_stat_of_existing_results():
    """gd_stat recorded in the first gene_summary.json already under RESULTS_DIR, or None
    when the folder has none yet. JSONs written before gd_stat existed were all
    nucleotide diversity, hence the "pi" fallback."""
    for path in glob.iglob(f"{RESULTS_DIR}/results/*/*_gene_summary.json"):
        with open(path) as fh:
            return json.load(fh).get("gd_stat", "pi")
    return None


# One results_dir per statistic: a re-run under a different gd_stat would overwrite the
# JSONs but leave the old statistic's PNGs sitting next to the new ones in the same
# per-chromosome folders, and gene_catalog.html lists every PNG it finds there.
_existing_gd_stat = gd_stat_of_existing_results()
if _existing_gd_stat not in (None, GD_STAT):
    raise ValueError(
        f"results_dir {RESULTS_DIR!r} already holds a catalog built with gd_stat="
        f"{_existing_gd_stat!r}, but config.yaml now says {GD_STAT!r}. Point results_dir at a "
        f"new folder for this statistic (e.g. '{RESULTS_DIR}_{GD_STAT.lower()}'), or delete "
        f"{RESULTS_DIR!r} first to rebuild it in place."
    )

# rule all:
#     input:
#         # [f"results/gene_catalog/{GENE_CHROM[gene]}/{gene}" for gene in GENES],
#         [f"results/gene_catalog/{GENE_CHROM[gene]}/{wildcards.gene}" for gene in GENES], # Placeholder until i fix chr/gene* structure.

#     #     outdir=directory(f"results/gene_catalog/{chrom}"), # Placeholder until i fix chr/gene* structure.
#     # benchmark:
#     #     f"results/gene_catalog/{chrom}/{gene}_benchmark.tsv" # Placeholder until i fix chr/gene* structure.

def selected_gene_availability(wildcards):
    """Schedule reports, including per-gene neutral jobs, only for nonempty VCFs.

    Checkpoint evaluation pauses DAG expansion until every requested gene has
    been filtered. A zero-record VCF is a successful extraction, but is not an
    input on which the R report or a neutral simulation should run.
    """
    manifest = checkpoints.select_nonempty_genes.get().output.manifest
    with open(manifest) as handle:
        selected = json.load(handle)
    require_retained_genes(selected, f"{RESULTS_DIR}/skipped_genes.tsv")
    return selected


def ordinary_done_marker_paths(wildcards):
    # Only retained ordinary genes: including the reference would form a cycle.
    selected = selected_gene_availability(wildcards)
    wait_for_first_gene(selected)
    return [gene["done_path"] for gene in selected["retained"]]


def done_marker_paths(wildcards):
    selected = selected_gene_availability(wildcards)
    wait_for_first_gene(selected)
    targets = list(selected["retained"])
    if selected.get("neutral_reference"):
        targets.append(selected["neutral_reference"])
    return [gene["done_path"] for gene in targets]


def require_retained_genes(selected, report):
    # An explicit gene_list_limit: 0 can request the reference on its own.
    # It must not hide an all-skipped real gene list.
    reference_only = (selected["requested_count"] == 0
                      and selected.get("neutral_reference") is not None)
    if not selected["retained"] and not reference_only:
        raise WorkflowError(
            f"All {selected['requested_count']} requested gene(s) were skipped. "
            f"Run stopped before neutral preparation and catalog generation. "
            f"Skipped gene IDs and reasons: {report}"
        )


def availability_manifest(wildcards):
    # Aggregation also depends directly on the completed selection checkpoint.
    return checkpoints.select_nonempty_genes.get().output.manifest


def neutral_availability_manifest(wildcards):
    """Every neutral preparation path waits for the completed gene selection."""
    path = availability_manifest(wildcards)
    with open(path) as handle:
        require_retained_genes(json.load(handle), f"{RESULTS_DIR}/skipped_genes.tsv")
    # This is an ordering dependency, not a biological pool input. Changing
    # the requested gene list must not re-extract a reusable huge neutral pool.
    return ancient(path)


def neutral_source_after_selection(path):
    """Resolve external neutral sources only after the checkpoint succeeds.

    This also defers missing-source errors on directly requested neutral
    targets, so the gene-selection report can be written first.
    """
    def resolve(wildcards):
        neutral_availability_manifest(wildcards)
        return path
    return resolve


# ---- First-gene warm-up (see FIRST_GENE_WARMUP above) ----
_FIRST_GENE_ANNOUNCED = []


def first_gene_done_path(wildcards):
    """.done marker of the first retained gene in gene-list order, or None.

    Read from the selection manifest through the checkpoint, so a caller is postponed until gene
    selection has finished (as with the other manifest readers). Skipped genes never come first:
    the first gene is the first one that actually has a report to run."""
    selected = selected_gene_availability(wildcards)
    if not selected["retained"]:
        return None
    return selected["retained"][0]["done_path"]


def report_done_path(wildcards):
    return f"{RESULTS_DIR}/.snakemake_gene_catalog/{wildcards.chrom}/{wildcards.gene}.done"


def is_first_gene(wildcards):
    """True only for the one report that runs alone first - never for the reference row.

    Used for the report's threads/memory/runtime. A gene requested by name before gene selection has
    run (`snakemake results/.../GENE.done` on a catalog without a selection yet) has its resources
    evaluated while the selection checkpoint is still open: that is an ordinary request, and Snakemake
    must not be handed the checkpoint's exception there (it would stop the run)."""
    if not FIRST_GENE_WARMUP or is_neutral_reference(wildcards):
        return False
    try:
        first = first_gene_done_path(wildcards)
    except IncompleteCheckpointException:
        return False
    return first == report_done_path(wildcards)


def first_gene_marker(wildcards):
    """Input of checkpoint first_gene_warmup_done: the first gene's report marker. Pulling it in is what
    makes Snakemake plan the first gene (its extraction, neutral preparation and report) at this stage.

    Evaluated only when the checkpoint is part of the plan, i.e. when the whole catalog is requested, so
    this is also where the warm-up is announced (once per run): a request for one gene's marker never
    reaches it. Whether the plan is partial is not known here (Snakemake decides what is out of date
    later), so a dry run gets a statement that is true either way."""
    selected = selected_gene_availability(wildcards)
    if not selected["retained"]:
        raise WorkflowError("The first-gene warm-up marker needs at least one retained gene.")
    first = selected["retained"][0]
    if not _FIRST_GENE_ANNOUNCED:
        _FIRST_GENE_ANNOUNCED.append(first["gene_id"])
        others = selected["retained_count"] - 1
        if not os.path.exists(first["done_path"]):
            logger.info(
                f"First-gene warm-up: {first['gene_id']} runs alone first "
                f"({min(FIRST_GENE_THREADS, workflow.cores)} threads, {first_gene_memory_mb()} MB); "
                f"the other {others} gene(s) are planned once its report is done. "
                f"first_gene_warmup: false starts all genes together.")
        elif getattr(workflow, "dryrun", False):
            logger.info(
                f"First-gene warm-up is on: a dry run lists the other {others} gene(s) only while the report of "
                f"{first['gene_id']} and the warm-up marker are up to date; if either has to be (re)made, only "
                f"that gene is listed and the others are planned after it.")
    return [first["done_path"]]


def wait_for_first_gene(selected):
    """Postpones planning every report but the first until the first gene's report is done.

    Called by the two input functions that list ALL reports (the aggregation's markers and the
    reference row's ordinary_reports_complete) and by nothing else: a gene's own jobs must not wait
    for the checkpoint that waits for the first gene's report. Until that checkpoint has run,
    checkpoints.first_gene_warmup_done.get() raises (it also does so on the first look of every run,
    before Snakemake has registered a checkpoint that is already up to date, so this says nothing
    about whether the plan stays partial) and Snakemake plans only the first gene. Afterwards the other
    genes are planned with exactly the inputs they have without the warm-up, so what is out of date is
    decided as it always was: an edited Rmd or preset re-runs every report, `--forcerun
    run_wingen_report` re-runs every report, re-running the first report alone re-runs no other gene.
    A dry run (-n) made while the first report or the marker has to be (re)made shows only that first
    gene, like any run before the gene-selection checkpoint."""
    if FIRST_GENE_WARMUP and selected["retained_count"] > 1:
        checkpoints.first_gene_warmup_done.get()


def first_gene_warmup_stamp(wildcards):
    """Input of the aggregation: the checkpoint's marker, i.e. the time the first report finished.
    Without it, re-running the first report alone (a forced re-run, an edit that only that gene's
    input has seen) would leave the catalog built from its previous summary: the marker files are
    empty and Snakemake ignores a newer empty file whose content is unchanged."""
    selected = selected_gene_availability(wildcards)
    if FIRST_GENE_WARMUP and selected["retained_count"] > 1:
        return [checkpoints.first_gene_warmup_done.get().output.marker]
    return []


# # GPT test for chr/gene* structure.
# rule all:
#     input:
#         [
#             f"results/.snakemake_gene_catalog/{GENE_CHROM[gene]}/{gene}.done"
#             for gene in GENES
#         ],

def first_gene_warmup_target(wildcards):
    """The warm-up marker as a target of `rule all`, when there are at least two genes to wait for.

    Everything that waits for the warm-up checkpoint (the aggregation, the catalog page, the reference row) can only be judged out of date or not once the checkpoint exists, because until then its input is a placeholder. If nothing asks for the marker while the first report is up to date - a catalog finished without the warm-up, or one whose marker was deleted - the checkpoint never runs and those jobs are never judged: an edited aggregation script, for instance, would plan nothing. Asking for the marker here makes the (very cheap) checkpoint run once; after that they are planned and judged like any other job. With the warm-up off, or with a single gene, this is empty and `all` gets no extra input."""
    if not FIRST_GENE_WARMUP:
        return []
    selected = selected_gene_availability(wildcards)
    return [FIRST_GENE_WARMUP_MARKER] if selected["retained_count"] > 1 else []


rule all:
    input:
        f"{RESULTS_DIR}/results/gene_catalog.html",
        f"{RESULTS_DIR}/results/gene_catalog.duckdb",
        first_gene_warmup=first_gene_warmup_target,


def filter_mode(wildcards):
    """Mirrors the if/else in create_gene_vcf_file(): chr mode needs a
    region resolved from a BED file, gene mode hands the gene ID straight
    to filter_vcf_by_chr_or_gene.sh, which does its own SnpEff-ANN vs.
    fallback detection from the VCF header - not from this flag."""
    if is_neutral_reference(wildcards):
        return "neutral_pool"
    return "chr" if VCF_ANNOTATION_FORMAT == "bed" else "gene"

def filter_value(wildcards):
    """Gene ID for gene mode; chr:start-end region for BED mode.

    The region is what bcftools -r expects: 1-based and inclusive. A BED start
    is 0-based, hence the + 1 - passing it through unchanged would pull in the
    one base just before the gene (checked: BED row "chr1 100 200" covers 1-based
    positions 101-200, but -r chr1:100-200 also returns a variant at 100)."""
    if VCF_ANNOTATION_FORMAT == "bed":
        try:
            chrom, start, end = LIST_BED[(wildcards.chrom, wildcards.gene)]
        except KeyError:
            raise ValueError(
                f"Gene {wildcards.gene!r} on {wildcards.chrom} was not found in {GENE_LIST_FILE}"
            ) from None
        return f"{chrom}:{start + 1}-{end}"

    return wildcards.gene


def filter_chrom(wildcards):
    return LOCUS_CHROM[(wildcards.chrom, wildcards.gene)]

# def filter_value(wildcards):
#     """Gene ID for gene mode; resolved chr:start-end region for chr mode."""
#     if config["vcf_annotation_format"] == "bed":
#         # Port get_gene_region_from_bed() here once you're actually
#         # exercising bed mode - look wildcards.gene up in
#         # config["gene_bed_file"] and return "chrom:start-end".
#         raise NotImplementedError("bed-mode region lookup not ported yet")
#     return wildcards.gene


def wingen_env_prefix(wildcards):
    """Turn config['wingen_params'] into 'KEY1="val1" KEY2="val2" ...' for
    the shell command below. Anything not set in config.yaml is simply
    omitted, so the Rmd's own Sys.getenv(..., unset = default) fallback
    applies - exactly like leaving the matching export commented out in
    2_wingen_create_gene_catalog.sh does today."""
    params = config.get("wingen_params", {}) or {}
    return " ".join(f'{k}="{v}"' for k, v in params.items() if v is not None)


def report_wingen_helper_inputs(wildcards):
    """Track the required adapter and diagnostics when the optional file exists."""
    paths = ["code/help_functions/wingen_efficiency.R"]
    diagnostics = "code/help_functions/wingen_diagnostics.R"
    if os.path.isfile(diagnostics):
        paths.append(diagnostics)
    return paths


# BEGIN OLS_MODEL_AGREEMENT_DEPENDENCIES
def report_location_screening_inputs(wildcards):
    """Track the optional HTML viewer; the main Rmd fits and exports models."""
    settings = config.get("wingen_params", {}) or {}
    if not isinstance(settings, dict):
        raise ValueError("wingen_params must be a YAML mapping")
    enabled = settings.get("LOCATION_SCREENING_ENABLED", False)
    if not isinstance(enabled, bool):
        raise ValueError("LOCATION_SCREENING_ENABLED must be a YAML boolean")
    if not config.get("use_copernicus_marine", False) or not enabled:
        return []
    return ["code/templates/prediction_agreement.template.html"]
# END OLS_MODEL_AGREEMENT_DEPENDENCIES


rule filter_vcf_for_gene:
    """create_gene_vcf_file(): subset the cohort VCF to one gene's variants."""
    wildcard_constraints:
        chrom=r"chr[^/]+",
    input:
        vcf=config["input_vcf"],
        script="code/filter_vcf_by_chr_or_gene.sh",
    output:
        vcf=f"{RESULTS_DIR}/temp/filtered_vcf/{{chrom}}/{{gene}}_filtered.vcf.gz",
        record_count=f"{RESULTS_DIR}/temp/filtered_vcf/{{chrom}}/{{gene}}_filtered.vcf.gz.record_count",
    params:
        mode=filter_mode,
        value=filter_value,
        chrom=filter_chrom,
    container:
        CONTAINER
    # conda:
    #     "wingen_env"
    # container:
    #     # confirmed to exist on quay.io as of this writing - still worth
    #     # picking the exact bcftools version you actually want rather
    #     # than trusting this pin blindly
    #     "docker://quay.io/biocontainers/bcftools:1.21--h3a4d415_1"
    threads: 2
    resources:
        # not measured separately from run_wingen_report below - filtering
        # a single small gene region is a much lighter operation than the
        # R rendering step, these are a deliberately small guess rather
        # than an attempt at a real number
        # mem_mb=2000,
        # runtime=10,
        mem_mb=lambda wildcards, attempt: 2000 * attempt,
        runtime=lambda wildcards, attempt: 10 * attempt,
    retries: 2
    shell:
        """
        export FILTER_GENE_CHROM={params.chrom:q}
        export VCF_RECORD_COUNT_FILE={output.record_count:q}
        bash {input.script:q} \
            {input.vcf:q} {params.mode:q} {params.value:q} {output.vcf:q} true
        """


rule narrow_vcf_by_scope:
    """
    filter_vcf_by_scope.sh: narrow an already gene-filtered VCF down to a
    specific annotation scope (body/exonic/cds), reading each variant's
    own ANN block for this gene. Only ever appears in the DAG when
    config['gene_scope'] != "all" - see wingen_vcf_input() below, which
    decides whether run_wingen_report depends on this rule's output or
    skips straight to filter_vcf_for_gene's.
    """
    wildcard_constraints:
        chrom=r"chr[^/]+",
    input:
        vcf=rules.filter_vcf_for_gene.output.vcf,
        script="code/filter_vcf_by_scope.sh",
    output:
        vcf=f"{RESULTS_DIR}/temp/filtered_vcf/{{chrom}}/{{gene}}_{GENE_SCOPE}.vcf.gz",
        record_count=f"{RESULTS_DIR}/temp/filtered_vcf/{{chrom}}/{{gene}}_{GENE_SCOPE}.vcf.gz.record_count",
    params:
        gene=lambda wc: wc.gene,
        scope=GENE_SCOPE,
    container:
        CONTAINER
    # conda:
    #     "wingen_env"
    # container:
    #     "docker://quay.io/biocontainers/bcftools:1.21--h3a4d415_1"
    threads: 2
    resources:
        # mem_mb=2000,
        # runtime=10,
        mem_mb=lambda wildcards, attempt: 2000 * attempt,
        runtime=lambda wildcards, attempt: 10 * attempt,
    retries: 2
    shell:
        """
        export VCF_RECORD_COUNT_FILE={output.record_count:q}
        bash {input.script:q} \
            {input.vcf} {params.gene} {params.scope} {output.vcf} true
        """


def wingen_vcf_input(wildcards):
    """Feeds run_wingen_report the scope-narrowed VCF when gene_scope is
    set, otherwise the plain gene-filtered VCF - mirrors filtered_vcf_file
    only getting reassigned to scope_vcf_file in create_gene_catalog()
    when gene_scope != "all"."""
    if is_neutral_reference(wildcards):
        neutral_availability_manifest(wildcards)
        return NEUTRAL_REFERENCE_VCF
    if GENE_SCOPE != "all":
        return f"{RESULTS_DIR}/temp/filtered_vcf/{wildcards.chrom}/{wildcards.gene}_{GENE_SCOPE}.vcf.gz"
    return f"{RESULTS_DIR}/temp/filtered_vcf/{wildcards.chrom}/{wildcards.gene}_filtered.vcf.gz"


# Describe this run explicitly; do not discover old gene outputs by glob.
GENE_REQUESTS = []
for chrom, gene in LOCI:
    locus = (chrom, gene)
    record = {"gene_id": gene}
    if locus in LOCUS_CHROM:
        wildcard = SimpleNamespace(chrom=chrom, gene=gene)
        record.update(
            source_chrom=LOCUS_CHROM[locus],
            region=filter_value(wildcard),
            raw_vcf=f"{RESULTS_DIR}/temp/filtered_vcf/{chrom}/{gene}_filtered.vcf.gz",
            final_vcf=wingen_vcf_input(wildcard),
            summary_path=f"{RESULTS_DIR}/results/{chrom}/{gene}_gene_summary.json",
            done_path=f"{RESULTS_DIR}/.snakemake_gene_catalog/{chrom}/{gene}.done",
        )
        record["raw_count"] = record["raw_vcf"] + ".record_count"
        record["final_count"] = record["final_vcf"] + ".record_count"
    else:
        record["reason"] = "missing_gene_chromosome_mapping"
    GENE_REQUESTS.append(record)

# Keep this out of GENE_REQUESTS: the full pool has no gene interval or
# chromosome, and must not pass through extraction/scope availability checks.
NEUTRAL_REFERENCE_REQUEST = None
if RUN_NEUTRAL_REFERENCE:
    folder, gene = NEUTRAL_REFERENCE_LOCUS
    NEUTRAL_REFERENCE_REQUEST = {
        "gene_id": gene,
        "target_type": "neutral_pool",
        "final_vcf": NEUTRAL_REFERENCE_VCF,
        "summary_path": f"{RESULTS_DIR}/results/{folder}/{gene}_gene_summary.json",
        "done_path": f"{RESULTS_DIR}/.snakemake_gene_catalog/{folder}/{gene}.done",
    }

# ---- Merge extraction results; the checkpoint never reopens the VCFs. ----
REPORT_COLUMNS = (
    "gene_id", "chromosome", "requested_region", "gene_scope", "reason",
    "raw_vcf_records", "retained_vcf_records",
)
MISSING_MAPPING = "missing_gene_chromosome_mapping"


def atomic_selection_text(path, contents):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as stream:
            stream.write(contents)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_gene_record_count(path):
    # Written atomically by the successful Bash filter job. A missing or
    # malformed status is a failed extraction, never an inferred zero.
    value = Path(path).read_text(encoding="utf-8").strip()
    if not re.fullmatch(r"[0-9]+", value):
        raise ValueError(f"Invalid extraction record count: {path}")
    return int(value)


def publish_gene_selection(requests, scope, manifest_path, report_path, neutral_reference=None):
    manifest_path, report_path = Path(manifest_path), Path(report_path)
    retained, skipped = [], []
    for requested in requests:
        record = dict(requested)
        if record.get("reason") == MISSING_MAPPING:
            record.update(raw_records=None, final_records=None)
            skipped.append(record)
            continue
        raw = read_gene_record_count(record["raw_count"])
        final = raw if record["final_count"] == record["raw_count"] else read_gene_record_count(record["final_count"])
        if final > raw:
            raise ValueError(f"Scope-filtered record count exceeds raw count for {record['gene_id']}")
        record.update(raw_records=raw, final_records=final)
        if not raw:
            record["reason"] = "no_matching_input_records"
            skipped.append(record)
        elif not final:
            record["reason"] = "no_records_after_scope_filter"
            skipped.append(record)
        else:
            retained.append(record)
    manifest = {"schema_version": 1, "gene_scope": scope,
                "retained": retained, "skipped": skipped,
                "requested_count": len(requests),
                "retained_count": len(retained), "skipped_count": len(skipped)}
    if neutral_reference is not None:
        manifest["neutral_reference"] = neutral_reference

    # Finish reading every status before publishing a report or removing the
    # previous one. Parallel filter jobs never append to the same report.
    if skipped:
        buffer = io.StringIO(newline="")
        writer = csv.writer(buffer, delimiter="\t", lineterminator="\n")
        writer.writerow(REPORT_COLUMNS)
        for record in skipped:
            writer.writerow([
                record["gene_id"], record.get("source_chrom") or ".", record.get("region") or ".",
                scope, record["reason"],
                record["raw_records"] if record["raw_records"] is not None else ".",
                record["final_records"] if record["final_records"] is not None else ".",
            ])
        atomic_selection_text(report_path, buffer.getvalue())
    elif report_path.exists():
        report_path.unlink()
    atomic_selection_text(manifest_path, json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
    return manifest

# ---- Extraction dependencies ----
# Changes to a gene list/map, its limit, scope or coordinates must
# invalidate the selection manifest. JSON params also track inline gene lists.
GENE_REQUEST_SOURCES = list(dict.fromkeys(
    path for path in (GENE_LIST_FILE, CHROM_SOURCE) if path and os.path.isfile(path)
))
GENE_FILTERED_INPUTS = list(dict.fromkeys(
    path for gene in GENE_REQUESTS
    for path in (gene.get("raw_vcf"), gene.get("final_vcf"), gene.get("raw_count"), gene.get("final_count"))
    if path is not None
))


checkpoint select_nonempty_genes:
    input:
        cohort=config["input_vcf"],
        sources=GENE_REQUEST_SOURCES,
        vcfs=GENE_FILTERED_INPUTS,
    output:
        manifest=f"{RESULTS_DIR}/temp/gene_availability.json",
    params:
        payload=json.dumps(GENE_REQUESTS, sort_keys=True),
        neutral_reference=json.dumps(NEUTRAL_REFERENCE_REQUEST, sort_keys=True),
        scope=GENE_SCOPE,
        report=f"{RESULTS_DIR}/skipped_genes.tsv",
    resources:
        mem_mb=1000,
    run:
        manifest = publish_gene_selection(json.loads(params.payload), params.scope,
                                          output.manifest, params.report,
                                          json.loads(params.neutral_reference))
        print(f"Gene availability: {manifest['retained_count']} retained; "
              f"{manifest['skipped_count']} skipped", flush=True)
        if manifest["skipped"]:
            print(f"Skipped-gene details (before neutral preparation): {params.report}", flush=True)
        require_retained_genes(manifest, params.report)

if FIRST_GENE_WARMUP:
    checkpoint first_gene_warmup_done:
        """
        First-gene warm-up: the aggregation (and the reference row) list every report only after this checkpoint has run, and it needs the first retained gene's report.
        So that report, with its extraction, neutral preparation and the cold download/build of the shared caches, is planned and run alone, with the whole allocation; every other gene is planned afterwards.
        The marker records when that report finished; the aggregation reads it (so that re-running the first report alone re-aggregates, as re-running any other gene does) and `rule all` asks for it (so that the checkpoint also runs once on a catalog whose reports are already up to date, e.g. one finished without the warm-up). No report lists it, so it never makes a report out of date.
        If the first report fails, this job does not run and no other gene is started.
        """
        input:
            first_report=first_gene_marker,
        output:
            marker=FIRST_GENE_WARMUP_MARKER,
        resources:
            mem_mb=100,
        run:
            report = Path(str(input[0]))
            Path(output.marker).parent.mkdir(parents=True, exist_ok=True)
            Path(output.marker).write_text(
                json.dumps({"first_gene_report": str(report), "report_finished_ns": report.stat().st_mtime_ns},
                           indent=2) + "\n", encoding="utf-8")
            print(f"First-gene warm-up: the report of {report.stem} is done; the other genes are planned now.", flush=True)

