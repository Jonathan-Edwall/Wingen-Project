# rule build_gene_catalog_html:
#     """
#     One static, sortable/searchable HTML page over the whole catalog -
#     DataTables.js loaded from its own CDN, no server needed. Deliberately
#     built only once, here, at the very end of the DAG, rather than kept
#     continuously up to date - a stale-until-the-next-full-run catalog
#     that's honest about it (see "generated <timestamp>" in the page
#     header) is a much simpler thing to reason about than one that's
#     subtly out of sync with a run still in progress.

#     Lives inside gene_catalog/ itself (not one level up at
#     results/gene_catalog.html) - purely a placement choice, doesn't
#     change anything about how it's built.
#     """
#     input:
#         duckdb=rules.aggregate_gene_summaries.output.duckdb,
#     output:
#         html="results/gene_catalog/gene_catalog.html",
#     conda:
#         "wingen_env"
#     # container:
#     #     CONTAINER
#     script:
#         "../code/build_gene_catalog_html.py"

rule build_gene_catalog_html:
    """
    One static, sortable/searchable HTML page over the whole catalog -
    DataTables.js loaded from its own CDN, no server needed. Deliberately
    built only once, here, at the very end of the DAG, rather than kept
    continuously up to date - a stale-until-the-next-full-run catalog
    that's honest about it (see "generated <timestamp>" in the page
    header) is a much simpler thing to reason about than one that's
    subtly out of sync with a run still in progress.

    Lives inside {RESULTS_DIR}/results/ itself, alongside the duckdb and
    tsv it's built from - not off in a separately-named folder - so all
    three sibling outputs of one catalog's aggregation step stay together.
    """
    input:
        duckdb=rules.aggregate_gene_summaries.output.duckdb,
    output:
        html=f"{RESULTS_DIR}/results/gene_catalog.html",
    container:
        CONTAINER
    # conda:
    #     "wingen_env"
    shell:
        """
        python code/build_gene_catalog_html.py \
            --duckdb {input.duckdb} \
            --html {output.html}
        """

# rule build_gene_catalog_html:
#     """
#     One static, sortable/searchable HTML page over the whole catalog -
#     DataTables.js loaded from its own CDN, no server needed. Deliberately
#     built only once, here, at the very end of the DAG, rather than kept
#     continuously up to date - a stale-until-the-next-full-run catalog
#     that's honest about it (see "generated <timestamp>" in the page
#     header) is a much simpler thing to reason about than one that's
#     subtly out of sync with a run still in progress.

#     Lives inside gene_catalog/ itself (not one level up at
#     results/gene_catalog.html) - purely a placement choice, doesn't
#     change anything about how it's built.
#     """
#     input:
#         duckdb=rules.aggregate_gene_summaries.output.duckdb,
#     output:
#         html="results/gene_catalog/gene_catalog.html",
